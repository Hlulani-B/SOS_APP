# Neon connection string - find it in the Neon dashboard:
# Project -> Connection Details -> Connection string.
# Keep sslmode=require, and use the POOLED string for an app like this
# that opens many short-lived connections.
#
# This file is git-ignored (see .gitignore). NEVER commit the real value.
DATABASE_URL=PASTE_POOLED_NEON_CONNECTION_STRING

# Comma-separated list of frontend origins allowed to call this API
# (the deployed site and, if wanted, the Vite dev server). Empty/unset
# disables CORS headers entirely, which is correct locally because the
# Vite proxy makes requests same-origin.
CORS_ORIGINS=
