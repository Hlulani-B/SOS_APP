# Neon connection string - find it in the Neon dashboard:
# Project -> Connection Details -> Connection string.
# Keep sslmode=require, and use the POOLED string for an app like this
# that opens many short-lived connections.
#
# This file is git-ignored (see .gitignore). NEVER commit the real value.
DATABASE_URL=PASTE_POOLED_NEON_CONNECTION_STRING

# OBSOLETE: index.js now uses wildcard cors() for every origin, so this
# variable is ignored. Kept only as a placeholder for old deployments.
CORS_ORIGINS=

# Supabase Storage for recording uploads
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=recordings
