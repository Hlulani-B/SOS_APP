# Neon connection string - find it in the Neon dashboard:
# Project -> Connection Details -> Connection string.
# Keep sslmode=require, and use the POOLED string for an app like this
# that opens many short-lived connections.
#
# This file is git-ignored (see .gitignore). NEVER commit the real value.
DATABASE_URL=PASTE_POOLED_NEON_CONNECTION_STRING

# Comma-separated list of EXTRA frontend origins allowed to call this API
# (dev servers, preview deploys). This list is ADDITIVE: the deployed
# sos-web origins and the Capacitor WebView origins are always allowed from
# index.js regardless of what is set here, and anything listed here joins
# them. Leave empty unless you need an additional origin.
CORS_ORIGINS=
