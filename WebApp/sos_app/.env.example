# Firebase Auth (Google provider) - Firebase console -> Project settings ->
# General -> Your apps -> SDK setup and configuration.
# These values are public by design: they identify the project, they do not
# authenticate a server. A Firebase service-account key / Admin SDK credential
# must NEVER appear here.
VITE_FIREBASE_API_KEY=PASTE_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=PASTE_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_SENDER_ID
VITE_FIREBASE_APP_ID=PASTE_APP_ID

# Express backend base URL. Leave EMPTY for local dev (the Vite proxy
# forwards /api/* to localhost:3000). When the API is deployed, paste its
# URL here without a trailing slash, e.g. https://sos-api.onrender.com
VITE_API_BASE=

# EmailJS (alert delivery to pals) - dashboard.emailjs.com -> Account ->
# General -> API Keys, and the Service ID / Template ID next to each item.
# The public key is safe to expose by design; EmailJS sends from the mailbox
# YOU connect in its dashboard to any recipient. Also set these on the
# Render sos-web service before deploying, and give the template
# To={{to_email}}, Subject={{subject}}, body {{message}}, attachment
# {{attachment}}.
VITE_EMAILJS_SERVICE_ID=PASTE_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=PASTE_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=PASTE_PUBLIC_KEY
